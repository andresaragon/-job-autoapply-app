# Supabase (Project Settings > API en tu proyecto de supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor Local de IA: Ollama ($0 / Offline en tu GPU RTX 4060)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Proveedor Nube Primario: Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Proveedor Nube de Respaldo: Google Gemini (aistudio.google.com > API Keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Preferencia por defecto: auto | ollama | anthropic | gemini
DEFAULT_AI_PROVIDER=auto

# Automatización y Webhooks n8n
N8N_WEBHOOK_SECRET=tu_token_secreto_para_n8n
NEXT_PUBLIC_APP_URL=http://localhost:3000

