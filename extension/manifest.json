{
  "manifest_version": 3,
  "name": "JobAutoApply Assistant — Auto-Fill ATS",
  "version": "1.0.0",
  "description": "Autollenado inteligente de formularios de empleo en 1-clic para Greenhouse, Lever, Ashby, Workday y portales de empleo.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.ashbyhq.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.workday.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.bamboohr.com/*",
    "*://*.workable.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobAutoApply ATS Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
